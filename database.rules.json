{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['name', 'avatar', 'email'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 30"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().length <= 4"
        },
        "email": {
          ".validate": "newData.isString()"
        },
        "highScore": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "gamesPlayed": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "totalPlayTime": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "battleMTK": {
          "highScore": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "stages": {
            "$stage": {
              ".validate": "$stage.matches(/^([1-9]|10)$/)",
              "stars": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
              },
              "bestCombo": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              }
            }
          }
        },
        "snakeArcade": {
          "highScore": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "highLength": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "bestDuration": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    }
  }
}
